# Copy to .env and fill in API keys.
#
# EC2 + HTTPS (DuckDNS):
#   docker compose -f docker-compose.yml -f deploy/docker-compose.https.yml up -d --build
#   See docs/DEPLOY_HTTPS_DDNS.md
#
# Local dev (no Caddy):
#   docker compose up
#   Use the commented localhost URLs below instead of jarvis-kd.duckdns.org

# ---------------------------------------------------------------------------
# Upstream APIs
# ---------------------------------------------------------------------------
# GNews — https://gnews.io/ (required for news tools)
GNEWS_API_KEY=

# Optional enrichment
FINNHUB_API_KEY=
ALPHA_VANTAGE_API_KEY=

# ---------------------------------------------------------------------------
# Redis (Docker Compose — do not use localhost inside the MCP container)
# ---------------------------------------------------------------------------
REDIS_URL=redis://redis:6379/0

# ---------------------------------------------------------------------------
# MCP server — public URLs (DuckDNS + Caddy on 443)
# ---------------------------------------------------------------------------
MCP_HOST=0.0.0.0
MCP_PORT=8000
MCP_BASE_URL=https://jarvis-kd.duckdns.org
STREAMABLE_HTTP_PATH=/mcp
MCP_JSON_RESPONSE=true

# ---------------------------------------------------------------------------
# Auth
# ---------------------------------------------------------------------------
AUTH_MODE=keycloak
STATIC_TOKENS_JSON={}

# Keycloak — same host as MCP (Caddy routes /realms* to Keycloak)
KEYCLOAK_PUBLIC_URL=https://jarvis-kd.duckdns.org
KEYCLOAK_ISSUER=https://jarvis-kd.duckdns.org/realms/stocksonar
KEYCLOAK_AUTHORIZATION_SERVER=https://jarvis-kd.duckdns.org/realms/stocksonar
# Compose overrides JWKS to http://keycloak:8080/... inside the Docker network
KEYCLOAK_JWKS_URI=http://localhost:8090/realms/stocksonar/protocol/openid-connect/certs
KEYCLOAK_AUDIENCE=account

# ---------------------------------------------------------------------------
# Quotas & rate limits
# ---------------------------------------------------------------------------
GNEWS_DAILY_QUOTA=90
RATE_LIMIT_FREE=30
RATE_LIMIT_PREMIUM=150
RATE_LIMIT_ANALYST=500

# ---------------------------------------------------------------------------
# Local dev only (uncomment and comment out DuckDNS block above)
# ---------------------------------------------------------------------------
# MCP_BASE_URL=http://localhost:8000
# KEYCLOAK_PUBLIC_URL=http://localhost:8090
# KEYCLOAK_ISSUER=http://localhost:8090/realms/stocksonar
# KEYCLOAK_AUTHORIZATION_SERVER=http://localhost:8090/realms/stocksonar
# KEYCLOAK_JWKS_URI=http://localhost:8090/realms/stocksonar/protocol/openid-connect/certs
# REDIS_URL=redis://localhost:6379/0
